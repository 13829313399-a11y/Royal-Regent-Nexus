# Illustrative only. Supply actual secrets through server environment management.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=qwen_openai_compatible
ASSISTANT_QWEN_API_KEY=
ASSISTANT_QWEN_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_MODEL_CAPABILITIES_FILE=
ASSISTANT_CONNECT_TIMEOUT_SECONDS=10
ASSISTANT_UPSTREAM_IDLE_TIMEOUT_SECONDS=180
ASSISTANT_RUN_TIMEOUT_SECONDS=900
ASSISTANT_MAX_OUTPUT_TOKENS=
ASSISTANT_CONTEXT_CHARACTER_BUDGET=100000
ASSISTANT_PER_USER_CONCURRENCY=2
ASSISTANT_GLOBAL_CONCURRENCY=8
ASSISTANT_DAILY_TOKEN_BUDGET=
ASSISTANT_RETENTION_DAYS=
ASSISTANT_STORAGE_DIR=/app/backend/data/assistant
ASSISTANT_TRUSTED_ORIGINS=[]
ASSISTANT_MAX_FILE_BYTES=10485760
ASSISTANT_MAX_TOOL_ROUNDS=5

# Optional durable runs, per-step timeout and read-only operation budgets.
ASSISTANT_DURABLE_RUNS_ENABLED=false
ASSISTANT_STEP_TIMEOUT_SECONDS=300
ASSISTANT_OPERATIONS_QUERY_TIMEOUT_MS=1500

# Optional search profile. Supply an endpoint and its tested capability file together.
ASSISTANT_SEARCH_ENDPOINT=
ASSISTANT_SEARCH_REGION=cn-beijing
ASSISTANT_SEARCH_CAPABILITIES_FILE=

# Per-document and parser-worker limits.
ASSISTANT_MAX_DOCUMENT_PAGES=100
ASSISTANT_MAX_DOCUMENT_CHARACTERS=200000
ASSISTANT_FILE_PARSE_CONCURRENCY=2
ASSISTANT_FILE_PARSE_QUEUE_LIMIT=16
ASSISTANT_FILE_PARSE_TIMEOUT_SECONDS=60
ASSISTANT_FILE_PARSE_MEMORY_MB=512
