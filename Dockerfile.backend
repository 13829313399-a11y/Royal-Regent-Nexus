FROM node:24-bookworm-slim AS image-pipeline-build
WORKDIR /build/shinobu-web
COPY shinobu-web/ ./
RUN npm ci --ignore-scripts --no-audit --no-fund && npm run build:server

FROM node:24-bookworm-slim AS image-pipeline-deps
ENV ONNXRUNTIME_NODE_INSTALL=skip
WORKDIR /runtime
COPY shinobu-web/server/runtime/package*.json ./
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ pkg-config libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    && npm ci --no-audit --no-fund

FROM python:3.13-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

WORKDIR /app/backend

COPY backend/requirements.prod.txt /tmp/requirements.prod.txt
COPY backend/scripts/install_document_translation_models.py /tmp/install_document_translation_models.py
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libjpeg62-turbo \
        libgif7 \
        librsvg2-2 \
        libreoffice-calc \
        libreoffice-writer \
        fonts-noto-cjk \
        python3-uno \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.prod.txt \
    && python /tmp/install_document_translation_models.py \
        --model-dir /app/backend/models/document-translation \
        --download-dir /tmp/document-translation-downloads \
    && rm -rf /tmp/document-translation-downloads

ENV DOCUMENT_TRANSLATION_MODEL_DIR=/app/backend/models/document-translation \
    DOCUMENT_TRANSLATION_DEVICE=cpu \
    IMAGE_TRANSLATION_MODEL_DIR=/app/backend/models/image-translation \
    IMAGE_TRANSLATION_RUNNER=/app/shinobu-web/server/dist/runner.mjs

COPY --from=image-pipeline-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=image-pipeline-deps /runtime/node_modules /app/shinobu-web/node_modules
COPY --from=image-pipeline-build /build/shinobu-web/server/dist /app/shinobu-web/server/dist
COPY shinobu-web/LICENSE shinobu-web/THIRD_PARTY_NOTICES.md /app/shinobu-web/

COPY backend/ ./
COPY src/ /app/src/
COPY shared/ /app/shared/

# Validate the packaged application syntax without requiring a live database.
RUN python -m compileall -q app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()" || exit 1

CMD ["sh", "-c", "alembic -c alembic.ini upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
