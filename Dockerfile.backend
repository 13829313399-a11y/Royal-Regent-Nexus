FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

WORKDIR /app/backend

COPY backend/requirements.prod.txt /tmp/requirements.prod.txt
COPY backend/scripts/install_document_translation_models.py /tmp/install_document_translation_models.py
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libreoffice-calc \
        libreoffice-writer \
        fonts-noto-cjk \
        python3-uno \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.prod.txt \
    && python /tmp/install_document_translation_models.py \
        --model-dir /app/backend/models/document-translation \
        --download-dir /tmp/document-translation-downloads \
    && rm -rf /tmp/document-translation-downloads

ENV DOCUMENT_TRANSLATION_MODEL_DIR=/app/backend/models/document-translation \
    DOCUMENT_TRANSLATION_DEVICE=cpu

COPY backend/ ./
COPY docs/ai/ /app/docs/ai/
COPY src/ /app/src/

# Fail the image build when a reviewed Skill manifest references a Prompt
# fragment that is absent from the packaged runtime filesystem.
RUN python -c "from app.services.ai.skills.registry import SkillRegistry; from app.services.ai.tool_registry import build_default_tool_registry; tool_registry = build_default_tool_registry(); registry = SkillRegistry(tool_registry); core = registry.prompt_registry.load_core(); print(f'validated {len(registry.skills)} AI Skill Prompt fragments, {len(tool_registry.specs)} Tools and {core.fragment_id}')"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()" || exit 1

CMD ["sh", "-c", "alembic -c alembic.ini upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
