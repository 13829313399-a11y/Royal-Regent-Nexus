APP_NAME=Royal Regent Nexus API
APP_ENV=production

POSTGRES_DB=royal_regent_nexus
POSTGRES_USER=rrnexus
POSTGRES_PASSWORD=change-this-long-random-password

DATABASE_URL=postgresql+psycopg://rrnexus:change-this-long-random-password@db:5432/royal_regent_nexus
SESSION_COOKIE_SECURE=true
SEED_DEFAULT_ACCOUNTS=false
AUTHZ_MODE=legacy
AUTHZ_WRITES_ENABLED=false

# Leave blank unless intentionally seeding an initial admin account with a one-time strong password.
SEED_ADMIN_PASSWORD=
