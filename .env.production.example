APP_NAME=Royal Regent Nexus API
APP_ENV=production

POSTGRES_DB=royal_regent_nexus
POSTGRES_USER=rrnexus
POSTGRES_PASSWORD=change-this-long-random-password

DATABASE_URL=postgresql+psycopg://rrnexus:change-this-long-random-password@db:5432/royal_regent_nexus
SESSION_COOKIE_SECURE=true
SEED_DEFAULT_ACCOUNTS=false
AUTHZ_MODE=legacy
AUTHZ_WRITES_ENABLED=false
# Historical verification keys only, for example {"v0":"old-secret"}.
# Removing an id revokes it. Never commit real secrets.
THREE_D_ASSET_DIR=/app/backend/data/three-d-printing-assets
# Generate a long random value. The same token is configured only on the
# Huakang A edge agent; never expose it to the browser or commit it.
THREE_D_EDGE_AGENT_TOKEN=change-this-long-random-edge-token
THREE_D_COMMAND_TTL_SECONDS=120
THREE_D_COMMAND_POLL_INTERVAL_SECONDS=3

# Shared offline translation for pricing; the public tool center is a placeholder.
DOCUMENT_TRANSLATION_MODEL_DIR=/app/backend/models/document-translation
DOCUMENT_TRANSLATION_DEVICE=cpu
DOCUMENT_TOOLS_ENABLED=true

# Leave blank unless intentionally seeding an initial admin account with a one-time strong password.
SEED_ADMIN_PASSWORD=

# API 与独立 worker 使用同一持久目录；SQLite 强制单 worker。
DOCUMENT_TOOLS_STORAGE_DIR=/app/backend/data/document-tools
DOCUMENT_TOOLS_WORKER_CONCURRENCY=2
DOCUMENT_TOOLS_LEASE_SECONDS=90
DOCUMENT_TOOLS_OFFICE_COMMAND=soffice
DOCUMENT_TOOLS_UNO_PYTHON=/usr/bin/python3
DOCUMENT_TOOLS_OFFICE_TIMEOUT_SECONDS=300
DOCUMENT_TOOLS_AI_MODE=auto
# 地址从对应地域和业务空间控制台复制；密钥仅保存在未跟踪的后端环境。
DOCUMENT_TOOLS_QWEN_API_KEY=
DOCUMENT_TOOLS_QWEN_BASE_URL=
DOCUMENT_TOOLS_QWEN_PROTOCOL=dashscope
DOCUMENT_TOOLS_QWEN_OCR_MODEL=qwen3.5-ocr
DOCUMENT_TOOLS_QWEN_LAYOUT_MODEL=qwen3-vl-plus
CUSTOMER_ORDER_AI_ENABLED=false
CUSTOMER_ORDER_AI_CONNECTION=document_tools
CUSTOMER_ORDER_AI_MODEL=
CUSTOMER_ORDER_AI_TIMEOUT_SECONDS=25
CUSTOMER_ORDER_AI_BATCH_SECONDS=75
CUSTOMER_ORDER_AI_REVISION=1
DOCUMENT_TOOLS_TRANSLATION_MODEL=qwen3-vl-plus
IMAGE_TRANSLATION_MODEL_DIR=/app/backend/models/image-translation
IMAGE_TRANSLATION_RUNNER=/app/shinobu-web/server/dist/runner.mjs
IMAGE_TRANSLATION_NODE=node
IMAGE_TRANSLATION_TIMEOUT_SECONDS=1800
IMAGE_TRANSLATION_MAX_PIXELS=24000000
IMAGE_TRANSLATION_MAX_TOTAL_PIXELS=80000000

# 启用时填写电脑和手机共用的 HTTPS 地址（域名或固定公网 IPv4，443，无路径）。
# 使用 IP 时，证书须包含该 IP 的 iPAddress SAN，并在到期前自动续期和加载。
# 不填时不签发手机二维码。切换后用 deploy/check_qc_mobile.py 复验实际入口。
QC_MOBILE_PUBLIC_ORIGIN=
# 旧站分阶段启用 HTTPS 时，可单独要求移动验货执行正式来源、就绪和 Secure Cookie 检查。
# APP_ENV=production 本身即强制执行这些检查。
QC_MOBILE_REQUIRE_HTTPS=true

# IAM 工作区和人工办理；前端参数在构建时读取，后端参数在进程启动时读取。
VITE_IAM_IDENTITY_UI_ENABLED=true
VITE_POSITION_WORKBENCH_ENABLED=true
VITE_IAM_CONSOLIDATED_UI_ENABLED=true
VITE_IAM_STUDIO_ENABLED=true
IAM_ACCESS_STUDIO_WRITES_ENABLED=false
