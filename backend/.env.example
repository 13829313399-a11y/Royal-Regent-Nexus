APP_NAME=Royal Regent Nexus API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/royal_regent_nexus
SESSION_COOKIE_SECURE=false
SEED_DEFAULT_ACCOUNTS=true

# Keep legacy authorization authoritative until the compatibility matrix is verified.
# Use shadow to compare decisions without changing behavior, then enforce to activate IAM overrides.
AUTHZ_MODE=legacy
AUTHZ_WRITES_ENABLED=false

# Required when SEED_DEFAULT_ACCOUNTS=true. Must be at least 12 characters and must not be 123456.
SEED_ADMIN_PASSWORD=

# 华康A 3D打印模块。生产环境必须把图片目录挂载到持久化卷，并使用高强度随机令牌。
THREE_D_ASSET_DIR=/app/backend/data/three-d-printing-assets
THREE_D_EDGE_AGENT_TOKEN=
THREE_D_COMMAND_TTL_SECONDS=120
THREE_D_COMMAND_POLL_INTERVAL_SECONDS=3

# 报价功能保留共用离线翻译服务。
DOCUMENT_TRANSLATION_MODEL_DIR=/app/backend/models/document-translation
DOCUMENT_TRANSLATION_DEVICE=cpu
DOCUMENT_TOOLS_ENABLED=true

# API 与独立 worker 使用同一持久目录；SQLite 强制单 worker。
DOCUMENT_TOOLS_STORAGE_DIR=/app/backend/data/document-tools
DOCUMENT_TOOLS_WORKER_CONCURRENCY=2
DOCUMENT_TOOLS_LEASE_SECONDS=90
DOCUMENT_TOOLS_OFFICE_COMMAND=soffice
DOCUMENT_TOOLS_UNO_PYTHON=/usr/bin/python3
DOCUMENT_TOOLS_OFFICE_TIMEOUT_SECONDS=300
DOCUMENT_TOOLS_AI_MODE=auto
# 地址从对应地域和业务空间控制台复制；密钥仅保存在未跟踪的后端环境。
DOCUMENT_TOOLS_QWEN_API_KEY=
DOCUMENT_TOOLS_QWEN_BASE_URL=
DOCUMENT_TOOLS_QWEN_PROTOCOL=dashscope
DOCUMENT_TOOLS_QWEN_OCR_MODEL=qwen3.5-ocr
DOCUMENT_TOOLS_QWEN_LAYOUT_MODEL=qwen3-vl-plus
DOCUMENT_TOOLS_TRANSLATION_MODEL=qwen3-vl-plus
# 图片原位翻译：由管理员安装一次，API 与 worker 使用相同只读模型目录。
IMAGE_TRANSLATION_MODEL_DIR=/app/backend/models/image-translation
IMAGE_TRANSLATION_RUNNER=/app/shinobu-web/server/dist/runner.mjs
IMAGE_TRANSLATION_NODE=node
IMAGE_TRANSLATION_TIMEOUT_SECONDS=1800
IMAGE_TRANSLATION_MAX_PIXELS=24000000
IMAGE_TRANSLATION_MAX_TOTAL_PIXELS=80000000
# 华兴 PDF 批量改名自动复用上述连接及布局模型；AI_MODE=off 时仅使用本地识别。

# 成员协作需先执行 20261009_0151 迁移；默认关闭。
COLLABORATION_ENABLED=false
COLLABORATION_STORAGE_DIR=/app/backend/data/collaboration-assets

# 曜灵 v2 原生联网为独立配置；不要用旧 Chat Completions profile 宣称已验证。
# 使用同一空间经确认的原生 URL，不要直接把兼容接口 URL 当作原生 URL。
ASSISTANT_SEARCH_ENDPOINT=
ASSISTANT_SEARCH_REGION=cn-beijing
ASSISTANT_SEARCH_CAPABILITIES_FILE=
# 文件/成果需显式迁移到 20261012_0158；默认支持 TXT、MD、CSV、文本 PDF。
ASSISTANT_MAX_DOCUMENT_PAGES=100
ASSISTANT_MAX_DOCUMENT_CHARACTERS=200000
ASSISTANT_FILE_PARSE_CONCURRENCY=2
ASSISTANT_FILE_PARSE_QUEUE_LIMIT=16
ASSISTANT_FILE_PARSE_TIMEOUT_SECONDS=60
ASSISTANT_FILE_PARSE_MEMORY_MB=512

# Embedded QC: npm run dev owns the local sidecar. For direct uvicorn set true.
QC_DEPARTMENT_MANAGED=false
QC_DEPARTMENT_URL=http://127.0.0.1:3411
# Optional absolute directory; default: backend/data/qc-department/companies
# QC_DEPARTMENT_DATA_DIR=/absolute/project/backend/data/qc-department/companies
# External sidecar: API and Node must use the same private 32+ character token.
QC_DEPARTMENT_GATEWAY_TOKEN=
