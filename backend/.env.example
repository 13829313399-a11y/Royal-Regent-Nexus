APP_NAME=Royal Regent Nexus API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/royal_regent_nexus
SESSION_COOKIE_SECURE=false
SEED_DEFAULT_ACCOUNTS=true

# Keep legacy authorization authoritative until the compatibility matrix is verified.
# Use shadow to compare decisions without changing behavior, then enforce to activate IAM overrides.
AUTHZ_MODE=legacy
AUTHZ_WRITES_ENABLED=false

# Required when SEED_DEFAULT_ACCOUNTS=true. Must be at least 12 characters and must not be 123456.
SEED_ADMIN_PASSWORD=

# 华康A 3D打印模块。生产环境必须把图片目录挂载到持久化卷，并使用高强度随机令牌。
THREE_D_ASSET_DIR=/app/backend/data/three-d-printing-assets
THREE_D_EDGE_AGENT_TOKEN=
THREE_D_COMMAND_TTL_SECONDS=120
THREE_D_COMMAND_POLL_INTERVAL_SECONDS=3

# 公共文档翻译使用服务器本地模型，正文不会发送到第三方翻译接口。
DOCUMENT_TRANSLATION_MODEL_DIR=/app/backend/models/document-translation
DOCUMENT_TRANSLATION_DEVICE=cpu

# AI Provider is disabled by default. Keep the API key server-side only.
AI_ENABLED=false
# NIF compatibility runtime. Keep off until the package-specific acceptance gates pass.
AI_NIF_RUNTIME_ENABLED=false
# Capability routing remains independently default-off during the NIF migration.
AI_PROVIDER_CAPABILITY_ROUTER_ENABLED=false
# Git-first Skill routing remains independently default-off during the NIF migration.
AI_SKILL_ROUTER_ENABLED=false
# Evidence v1 remains independently default-off during the NIF migration.
AI_EVIDENCE_V1_ENABLED=false
AI_CONVERSATIONS_ENABLED=false
AI_ADAPTIVE_SURFACE_ENABLED=false
AI_RICH_MESSAGE_RENDERER_ENABLED=false
AI_WORKBENCH_V2_ENABLED=false
AI_CONVERSATION_CONTEXT_ENABLED=false
AI_PRESENTATION_BLOCKS_ENABLED=false
# ADR-004/005 accepted engineering baseline (2026-08-12); code validates these exact values.
AI_CONVERSATION_MESSAGE_RETENTION_DAYS=30
AI_CONVERSATION_SUMMARY_RETENTION_DAYS=30
AI_CONVERSATION_TOMBSTONE_RETENTION_DAYS=180
AI_CONVERSATION_SECURITY_AUDIT_RETENTION_DAYS=180
AI_CONVERSATION_ACTION_AUDIT_RETENTION_DAYS=365
AI_CONVERSATION_BACKUP_RETENTION_DAYS=30
AI_CONVERSATION_BACKUP_DELETE_SLA_DAYS=30
# ADR-015 accepted engineering baseline (2026-08-12). Task API stays default-off.
AI_TASKS_ENABLED=false
AI_TASK_RETENTION_DAYS=180
AI_TASK_SECURITY_AUDIT_RETENTION_DAYS=180
AI_TASK_BACKUP_DELETE_SLA_DAYS=30
AI_TASK_WORKER_ENABLED=false
AI_TASK_WORKER_CONCURRENCY=1
AI_TASK_WORKER_LEASE_SECONDS=90
AI_TASK_WORKER_HEARTBEAT_SECONDS=15
AI_TASK_WORKER_MAX_RECOVERY_RETRIES=2
AI_TASK_WORKER_POLL_SECONDS=1
# ADR-007 accepted baseline. Shared PostgreSQL Guard stays default-off.
AI_SHARED_GUARD_ENABLED=false
AI_SEMANTIC_GATEWAY_ENABLED=false
AI_KNOWLEDGE_HUB_ENABLED=false
# ADR-009 accepted baseline. Artifact API is independently default-off and
# production uploads fail closed until ClamAV and private storage are configured.
AI_ARTIFACTS_ENABLED=false
AI_ARTIFACT_WORKFLOWS_ENABLED=false
AI_VISION_TOOL_COMPARISON_ENABLED=false
# Document Studio reuses AI Task + Artifact and stays independently default-off.
AI_DOCUMENT_STUDIO_ENABLED=false
AI_DOCUMENT_CLOUD_OCR_ENABLED=false
AI_DOCUMENT_OCR_MODEL=qwen3.5-ocr
AI_DOCUMENT_OCR_REGION=cn-beijing
AI_DOCUMENT_OCR_MAX_PAGES=50
AI_DOCUMENT_OCR_MAX_BYTES=20971520
AI_DOCUMENT_OCR_MAX_CONCURRENCY=2
AI_DOCUMENT_RECONCILE_ENABLED=false
AI_DOCUMENT_RECONCILE_MODEL=qwen3.7-plus
AI_DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# HTTP brokers use inline page images; HTTPS brokers use exact-host signed leases.
AI_DOCUMENT_SIGNED_FILE_SERVICE_URL=
AI_DOCUMENT_SIGNED_FILE_SERVICE_TOKEN=
AI_DOCUMENT_SIGNED_FILE_ALLOWED_HOSTS=
DOCUMENT_OFFICE_RENDERER_ENABLED=false
DOCUMENT_OFFICE_RENDERER_COMMAND=libreoffice
DOCUMENT_OFFICE_RENDERER_TIMEOUT_SECONDS=120
DOCUMENT_OFFICE_RENDERER_NETWORK_ISOLATION_COMMAND=unshare
DOCUMENT_OFFICE_RENDERER_NETWORK_ISOLATION_VERIFIED=false
AI_PREVIEW_TTL_MINUTES=30
AI_ARTIFACT_STORAGE_DIR=/app/backend/data/ai-artifacts
AI_ARTIFACT_SCANNER_BACKEND=disabled
AI_ARTIFACT_CLAMAV_HOST=clamav
AI_ARTIFACT_CLAMAV_PORT=3310
AI_ARTIFACT_CLAMAV_TIMEOUT_SECONDS=15
AI_ARTIFACT_RETENTION_DAYS=30
AI_ARTIFACT_TOMBSTONE_RETENTION_DAYS=180
AI_ARTIFACT_SECURITY_AUDIT_RETENTION_DAYS=180
AI_ARTIFACT_BACKUP_DELETE_SLA_DAYS=30
AI_ARTIFACT_BACKUP_PROVIDER=aliyun_oss
AI_ARTIFACT_BACKUP_REGION=
AI_ARTIFACT_BACKUP_BUCKET=
AI_ARTIFACT_BACKUP_KMS_KEY_ID=
AI_ARTIFACT_PRIVATE_VOLUME_VERIFIED=false
AI_ARTIFACT_CLAMAV_OPERATIONS_VERIFIED=false
AI_ARTIFACT_BACKUP_ENCRYPTION_VERIFIED=false
AI_ARTIFACT_BACKUP_RESTORE_DRILL_VERIFIED=false
# Blank creates a unique process/Worker instance ID automatically.
AI_GUARD_INSTANCE_ID=
AI_GUARD_LEASE_SECONDS=900
AI_GUARD_REQUEST_RETENTION_MINUTES=10
AI_GUARD_BUDGET_RETENTION_DAYS=35
AI_TASK_EVENT_STREAM_POLL_SECONDS=0.5
AI_TASK_EVENT_STREAM_MAX_SECONDS=25
# Optional strict Catalog v1 JSON. Blank uses the reviewed single-provider profile.
AI_MODEL_CATALOG_JSON=
AI_PROVIDER=qwen
AI_REGION=cn-beijing
AI_WORKSPACE_ID=
DASHSCOPE_API_KEY=
AI_DEFAULT_MODEL=qwen3.7-plus
AI_VISION_MODEL=qwen3.7-plus
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_RESULT_ROWS=50
AI_MAX_TOOL_RESULT_BYTES=65536
AI_MAX_TOOL_RESULT_FIELDS=64
AI_MAX_INPUT_MESSAGES=12
AI_MAX_INPUT_MESSAGE_CHARS=8000
AI_MAX_INPUT_CHARS=40000
# qwen3.7-plus defaults to xhigh; use a bounded default for latency and cost.
AI_REASONING_EFFORT=low
AI_LOG_RAW_PROMPTS=false
AI_LOG_RAW_TOOL_RESULTS=false
# Initial Pilot gate. Keep disabled and both allowlists empty until explicitly approved.
# User IDs are unique, comma-separated and bounded to 128; factories must use canonical IDs.
AI_PILOT_ENABLED=false
AI_PILOT_USER_IDS=
AI_PILOT_FACTORY_IDS=
# Operational assertion only; production additionally needs an external HTTPS/HSTS readiness check.
AI_PILOT_PUBLIC_TLS_VERIFIED=false
# Optional local kill-switch marker. Empty keeps development behavior unchanged.
AI_RUNTIME_DISABLE_PATH=
AI_PILOT_MAX_CONCURRENT_PER_USER=1
AI_PILOT_REQUESTS_PER_MINUTE=10
AI_PILOT_DAILY_TOKEN_BUDGET=20000000
AI_PILOT_MAX_OUTPUT_TOKENS=4096
AI_CLOUD_VISION_ENABLED=false
AI_MAX_IMAGE_ATTACHMENTS=3
AI_MAX_IMAGE_BYTES=4194304
AI_MAX_IMAGE_TOTAL_BYTES=12582912
AI_MAX_IMAGE_ENCODED_CHARS=17000000
AI_MAX_REQUEST_BYTES=18874368
AI_MAX_IMAGE_PIXELS=16000000
AI_MAX_IMAGE_TOTAL_PIXELS=24000000
AI_CLOUD_DOCUMENT_TRANSLATION_ENABLED=false
AI_CLOUD_WORKBOOK_MAPPING_ENABLED=false
# NIF-16 lifecycle/API and the sole consequential DRAFT Apply execution are separate gates.
AI_ACTION_GATEWAY_ENABLED=false
AI_CONTROLLED_APPLY_ENABLED=false
# NIF-17 feedback, metadata capture and administrator export are separate gates.
AI_FEEDBACK_ENABLED=false
AI_OBSERVABILITY_ENABLED=false
AI_METRIC_EXPORT_ENABLED=false
# Configure only from the approved Provider price sheet; zero means unavailable.
AI_INPUT_TOKEN_COST_USD_PER_MILLION=0
AI_OUTPUT_TOKEN_COST_USD_PER_MILLION=0
# NIF-18 internal operations channel. Enabling it requires all six positive
# thresholds, metadata observability/export, ClamAV Artifact readiness and one
# or more active recipient user IDs. Notifications contain metadata only and
# use the existing read/handled workflow for receiving-channel acknowledgement.
AI_OPERATIONAL_ALERTS_ENABLED=false
AI_ALERT_TARGET_USER_IDS=
AI_ALERT_EVALUATION_INTERVAL_SECONDS=300
AI_ALERT_WINDOW_MINUTES=15
AI_ALERT_COOLDOWN_MINUTES=60
AI_COST_PER_SUCCESSFUL_TASK_ALERT_MICROUSD=0
AI_PROVIDER_FAILURE_ALERT_COUNT=0
AI_TOOL_FAILURE_ALERT_COUNT=0
AI_WORKER_RECOVERY_ALERT_COUNT=0
AI_BUDGET_ALERT_PERCENT=0
AI_SCANNER_SIGNATURE_MAX_AGE_HOURS=0
# Deployment-script-only NIF-18 stage; keep disabled outside an approved field drill.
AI_NIF18_STAGE=disabled
# Optional custom endpoint for development/test only. Production rejects overrides.
AI_BASE_URL=
