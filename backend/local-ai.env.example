# Optional local AI development profile (no credentials).
#
# Start from backend/.env.example, keep the real backend/.env ignored by Git,
# then copy or merge these AI_* overrides into backend/.env. Provider keys and
# custom endpoints deliberately do not belong in this file.
#
# This profile exposes the production AI feature surface for local UI/API
# development. It is not production-readiness evidence: this workstation uses
# SQLite and has no local ClamAV operations channel, so the PostgreSQL Worker,
# shared multi-instance Guard and operational alerts remain disabled. Artifact
# APIs are visible, while uploads still fail closed until ClamAV is installed.

AI_ENABLED=true
AI_NIF_RUNTIME_ENABLED=true
AI_PROVIDER_CAPABILITY_ROUTER_ENABLED=true
AI_SKILL_ROUTER_ENABLED=true
AI_EVIDENCE_V1_ENABLED=true
AI_CONVERSATIONS_ENABLED=true
AI_ADAPTIVE_SURFACE_ENABLED=true
AI_RICH_MESSAGE_RENDERER_ENABLED=true
AI_WORKBENCH_V2_ENABLED=true
AI_CONVERSATION_CONTEXT_ENABLED=true
AI_PRESENTATION_BLOCKS_ENABLED=true
AI_TASKS_ENABLED=true
AI_TASK_WORKER_ENABLED=false
AI_SHARED_GUARD_ENABLED=false
AI_SEMANTIC_GATEWAY_ENABLED=true
AI_KNOWLEDGE_HUB_ENABLED=true
AI_ARTIFACTS_ENABLED=true
AI_ARTIFACT_WORKFLOWS_ENABLED=true
AI_VISION_TOOL_COMPARISON_ENABLED=true
AI_CLOUD_VISION_ENABLED=true
AI_CLOUD_DOCUMENT_TRANSLATION_ENABLED=true
AI_CLOUD_WORKBOOK_MAPPING_ENABLED=true
AI_ACTION_GATEWAY_ENABLED=true
AI_CONTROLLED_APPLY_ENABLED=true
AI_FEEDBACK_ENABLED=true
AI_OBSERVABILITY_ENABLED=true
AI_METRIC_EXPORT_ENABLED=true
AI_OPERATIONAL_ALERTS_ENABLED=false

AI_PILOT_ENABLED=true
AI_PILOT_USER_IDS=user-admin
AI_PILOT_FACTORY_IDS=huakang-a,huakang-b,huakang-c,huakang-d,huadeng,huaxing
AI_PILOT_PUBLIC_TLS_VERIFIED=false

AI_ARTIFACT_SCANNER_BACKEND=clamav
AI_ARTIFACT_CLAMAV_HOST=127.0.0.1
AI_ARTIFACT_CLAMAV_PORT=3310
AI_ARTIFACT_CLAMAV_TIMEOUT_SECONDS=3
AI_ARTIFACT_PRIVATE_VOLUME_VERIFIED=false
AI_ARTIFACT_CLAMAV_OPERATIONS_VERIFIED=false
AI_ARTIFACT_BACKUP_ENCRYPTION_VERIFIED=false
AI_ARTIFACT_BACKUP_RESTORE_DRILL_VERIFIED=false

AI_LOG_RAW_PROMPTS=false
AI_LOG_RAW_TOOL_RESULTS=false
AI_NIF18_STAGE=action-field
