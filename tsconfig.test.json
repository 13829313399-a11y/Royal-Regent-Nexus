{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/vite-env.d.ts",
    "src/env.d.ts",
    "src/types/**/*.d.ts",
    "src/features/ai-assistant/__tests__/*.spec.ts",
    "src/features/uv-printing/__tests__/*.spec.ts",
    "src/features/collaborative-sheets/*.spec.ts",
    "src/api/uvPrinting.spec.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals"]
  }
}
