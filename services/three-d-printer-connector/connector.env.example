# Backend URL only. HTTPS is mandatory unless the API is on loopback.
THREE_D_API_URL=http://127.0.0.1:8000
# Files mounted separately, readable only by the service account. No values here.
THREE_D_CONNECTOR_TOKEN_FILE=/run/secrets/three-d-connector-token
THREE_D_SECRET_DIR=/run/secrets/three-d-printers
# Configure the API process separately:
# THREE_D_CONNECTOR_ENABLED=true
# THREE_D_CONNECTOR_TOKEN=<same dedicated service token from your secret manager>
# THREE_D_CONNECTOR_CONTROL_ENABLED=false
# THREE_D_CONNECTOR_VERIFIED_MACHINES=[]
