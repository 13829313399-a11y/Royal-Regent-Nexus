FROM node:24-alpine AS build

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmmirror.com

COPY package.json package-lock.json ./
RUN npm config set registry ${NPM_REGISTRY} \
    && npm ci

COPY . .

# Native canvas/Node inference install hooks are only needed by tests, not Web builds.
RUN cd shinobu-web && npm ci --ignore-scripts

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_COLLABORATION_ENABLED=true
ENV VITE_COLLABORATION_ENABLED=${VITE_COLLABORATION_ENABLED}

RUN npm run build

FROM nginx:alpine AS runtime

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Vite preserves public-file modes; a restrictive checkout umask must not
# prevent the unprivileged Nginx worker from reading static assets.
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} +

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1/health || exit 1
